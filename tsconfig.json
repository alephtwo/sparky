{
  "include": ["src", "vite.config.mts", "vitest.setup.mts"],
  "compilerOptions": {
    "lib": ["dom", "esnext"],
    "types": ["vite/client", "@testing-library/jest-dom", "solid-js"],

    // Build
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,

    // JSX
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  }
}
